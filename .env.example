PLIMSOLL_DATABASE_URL=postgresql+asyncpg://plimsoll_app:plimsoll_app_dev@localhost:5432/plimsoll
PLIMSOLL_MIGRATION_DATABASE_URL=postgresql+asyncpg://plimsoll_owner:plimsoll_owner_dev@localhost:5432/plimsoll
PLIMSOLL_REDIS_URL=redis://localhost:6379/0
PLIMSOLL_S3_ENDPOINT=http://localhost:9000
# At least 32 bytes (RFC 7518 section 3.2). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PLIMSOLL_JWT_SECRET=change-me-to-at-least-32-bytes-of-entropy
# Encrypts stored credentials: 32 bytes, base64url. A deployment generates its
# own; there is no default, because a built-in key is the same as none.
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PLIMSOLL_CREDENTIAL_KEY=ZGV2ZWxvcG1lbnQtb25seS1rZXktMzItYnl0ZXMhISE=
PLIMSOLL_LOG_LEVEL=INFO
